{
  "name": "special-digital-things",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo Special Digital Things: hub katalog, produk digital (Goodiebox, ...), dan API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w apps/hub",
    "dev:goodiebox": "npm run dev -w apps/goodiebox",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "api:test": "cd services/api && go test ./...",
    "api:build": "cd services/api && go build -o bin/server ./cmd/server",
    "api:vet": "cd services/api && go vet ./..."
  }
}
